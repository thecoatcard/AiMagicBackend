# Redis connection (use rediss:// for TLS, redis:// for plain)
REDIS_URL=rediss://default:password@host:port

# Comma-separated Gemini API keys
GEMINI_KEYS=AIzaSy...,AIzaSy...,AIzaSy...

# Default model to use
DEFAULT_MODEL=gemini-2.5-flash

# Cooldown duration in ms when a key gets 429 (default: 60s)
COOLDOWN_MS=60000

# Max retries per request
MAX_RETRIES=8

# Timeout per individual Gemini call in ms
REQUEST_TIMEOUT_MS=25000

# MongoDB connection
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_NAME=keymanagement

# BullMQ worker concurrency (parallel jobs per instance)
WORKER_CONCURRENCY=5

# Email (Gmail SMTP — use an App Password, not your account password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password

# Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
OTP_TTL_MS=600000

# Server port
PORT=3000

# Owner account — seeded as role:owner on startup; receives all admin alert emails
OWNER_EMAIL=owner@example.com

# Allowed CORS origins (comma-separated). Defaults to http://localhost:3001
CORS_ORIGINS=http://localhost:3001,https://your-frontend.com

# Alert thresholds (overridable at runtime via PATCH /v1/admin/system)
QUEUE_BACKLOG_THRESHOLD=100
KEY_POOL_LOW_THRESHOLD=2
